   (27, 'Colfax Marathon - all Routes around Colfax', TO_DATE('05/08/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('05/17/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('05/05/2009 06:50:00', 'MM/DD/YYYY HH24:MI:SS'), 
