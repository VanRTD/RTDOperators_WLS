   (20, 'Shakespeare Festival Parade Rt. 8 and 48', TO_DATE('05/08/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('05/08/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('05/05/2009 07:39:00', 'MM/DD/YYYY HH24:MI:SS'), 
    'GSW  #11', 'The Denver Public Schools will have their annual Shakespeare Festival Parade. They will stage in Skyline Park. The parade will exit the park onto Arapahoe Street and proceeds down on Arapahoe Street to, left on 16th Street Mall to, right on Curtis Street and will disband at the Denver Performing Arts Complex (DPAC).<BR>
?<	Curtis between 14th & 17th Streets<BR>
o	Hard closure !V !?NO TRAFFIC!?<BR>
o	Routes 8 & 48 will continue 15th Street to, right on Lawrence to, right on 17th Street to, left on Curtis and regular routing. (This detour was entered on the Detour Sheet).', 'May 08, 2009 - May 08, 2009', NULL, NULL);
