   (8, 'Rt 15/20/DM Street name change ', TO_DATE('01/22/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('02/15/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('01/22/2009 08:38:00', 'MM/DD/YYYY HH24:MI:SS'), 
