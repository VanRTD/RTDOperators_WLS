   (9, 'Monthly passes', TO_DATE('02/02/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('02/02/2010 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), NULL, 
    'M. Ames', 'Dispatch is getting an increasing number of calls each month from bus Operators questioning if there is a grace period for our monthly passes. The passengers are claiming they are being told this by Bus Operators. <b>There is NOT, I repeat NOT any kind of grace period for our monthly bus passes. They are valid from 12:01am on the 1st of the month thru 11:59pm on the last day of the month.<b/> (S7)', 'February 02, 2009 - February 02, 2010', NULL, NULL);
