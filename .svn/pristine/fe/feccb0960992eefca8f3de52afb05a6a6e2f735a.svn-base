   (38, 'Denver Heart Walk', TO_DATE('06/07/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), TO_DATE('06/08/2009 00:00:00', 'MM/DD/YYYY HH24:MI:SS'), NULL, 
    'GSW  #11', 'This walk will start at Denver Convention Center to, exit and right on Champa to, left on 15th Street to, right on Little Raven to, left on 19th Street to, left on Platte Street to, left on 15th Street to, right on Lawrence and will terminate at Denver Performing Arts Complex (DPAC).<BR>
This detour will run with the People''s Fair - look for 2 detours on this day. <BR>
<BR>
Detours will be given out on the day of this event for more information check the public website under rider alert - Thanks', 'June 07, 2009 - June 08, 2009', NULL, NULL);
