<?xml version="1.0" encoding="UTF-8"?>

<decorators defaultdir="/WEB-INF/decorators">
        <excludes>
        <!--  unused JJH -->                
                <pattern>/rss.jsp</pattern>
                <pattern>/site/*</pattern>
                <pattern>/*/site/*</pattern>
                <pattern>/secure/*_*</pattern>
        </excludes>
        
        <decorator name="main" page="main.jsp" >
                <pattern>/*</pattern>
        </decorator>
        
        
</decorators>
