	tr.showHomePageAlert {
		display: table-row;
	}
	
	tr.noShowHomePageAlert {
		display: none;
	}
	
	.myDirector {
		background-color: #eaf2ff;
		border-width: 3px;
		border-style: solid;
		border-color: #000000;
		margin-top: 15px;
	}
	
