 * 
 */
package com.rtd.operator.model;

import java.util.Date;

/**
 * @author Van Tran
 *
 */

public class DetourRoute
{
	private String route;
	private String detourDetail;
	private String detourType;
	private String effectiveDate;
	private Date updateDate;
	
	/**
	 * default no arg constructor 
	 */
	public DetourRoute()
	{
		super();
	}

	/**
	 * @return returns the route
	 */
	public String getRoute()
	{
		return route;
	}

	/**
	 * @param route
	 */
	public void setRoute(final String route)
	{
		this.route = route;
	}

	/**
	 * @return returns the detourDetail
	 */
	public String getDetourDetail()
	{
		return detourDetail;
	}

	/**
	 * @param detourDetail
	 */
	public void setDetourDetail(final String detourDetail)
	{
		this.detourDetail = detourDetail;
	}

	/**
	 * @return returns the detourType
	 */
	public String getDetourType()
	{
		return detourType;
	}

	/**
	 * @param detourType
	 */
	public void setDetourType(final String detourType)
	{
		this.detourType = detourType;
	}

	/**
	 * @return returns the effectiveDate
	 */
	public String getEffectiveDate()
	{
		return effectiveDate;
	}

	/**
	 * @param effectiveDate
	 */
	public void setEffectiveDate(final String effectiveDate)
	{
		this.effectiveDate = effectiveDate;
	}
	
	/**
	 * @return returns the updateDate
	 */
	public Date getUpdateDate()
	{
		return updateDate;
	}

	/**
	 * @param updateDate
	 */
	public void setUpdateDate(final Date updateDate)
	{
		this.updateDate = updateDate;
	}

}
