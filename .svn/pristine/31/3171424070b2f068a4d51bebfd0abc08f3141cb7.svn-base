package com.rtd.operator.model;

/**
 * @author Justin Hancock
 * 
 */
public class TransportationBulletinSearchObject
{

	private String bulletinNumber;
	private String searchWords;

	/**
	 * 
	 */
	public TransportationBulletinSearchObject()
	{
		super();
	}

	/**
	 * @return returns the bulletinNumber
	 */
	public String getBulletinNumber()
	{
		return bulletinNumber;
	}

	/**
	 * @param BulletinNumber
	 */
	public void setBulletinNumber(final String bulletinNumber)
	{
		this.bulletinNumber = bulletinNumber;
	}

	/**
	 * @return returns the searchWords
	 */
	public String getSearchWords()
	{
		return searchWords;
	}

	/**
	 * @param searchWords
	 */
	public void setSearchWords(final String searchWords)
	{
		this.searchWords = searchWords;
	}

}
