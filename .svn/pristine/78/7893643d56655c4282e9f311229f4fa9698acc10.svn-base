SET DEFINE OFF;

SPOOL create_table_EXTRABOARD_BOX_RUNS.log;
--------------------------------------------------------

DROP TABLE ROS.EXTRABOARD_BOX_RUNS CASCADE CONSTRAINTS;

CREATE TABLE ROS.EXTRABOARD_BOX_RUNS
(
  VALID_DATE        DATE,
  RUN_NUMBER        VARCHAR2(10 BYTE),
  RUN_PIECE_NUMBER  NUMBER,
  SERVICE_TYPE_ID   NUMBER,
  BLOCK_NUMBER      NUMBER,
  ROUTE_ABBR        VARCHAR2(10 BYTE),
  BLOCK_PULLOUT     VARCHAR2(5 BYTE),
  BLOCK_PULLIN      VARCHAR2(5 BYTE),
  BOX_NBR           NUMBER,
  RELIEF_BOX_NUM    VARCHAR2(10 BYTE),
  BOX_SUFFIX        VARCHAR2(10 BYTE),
  FIRST_ROUTE       VARCHAR2(10 BYTE),
  LAST_ROUTE        VARCHAR2(10 BYTE),
  SIGNUP_TIME       VARCHAR2(5 BYTE),
  ON_TIME           VARCHAR2(5 BYTE),
  OFF_TIME          VARCHAR2(5 BYTE),
  RELIEF_LOCATION   VARCHAR2(10 BYTE)
)
TABLESPACE USERS
PCTUSED    0
PCTFREE    10
INITRANS   1
MAXTRANS   255
STORAGE    (
            INITIAL          64K
            MINEXTENTS       1
            MAXEXTENTS       UNLIMITED
            PCTINCREASE      0
            BUFFER_POOL      DEFAULT
           )
LOGGING 
NOCOMPRESS 
NOCACHE
NOPARALLEL
MONITORING;

DROP SYNONYM ROS_DS.EXTRABOARD_BOX_RUNS;

CREATE OR REPLACE SYNONYM ROS_DS.EXTRABOARD_BOX_RUNS FOR ROS.EXTRABOARD_BOX_RUNS;


DROP SYNONYM ROS_READ.EXTRABOARD_BOX_RUNS;

CREATE OR REPLACE SYNONYM ROS_READ.EXTRABOARD_BOX_RUNS FOR ROS.EXTRABOARD_BOX_RUNS;


DROP SYNONYM ROS_USER.EXTRABOARD_BOX_RUNS;

CREATE OR REPLACE SYNONYM ROS_USER.EXTRABOARD_BOX_RUNS FOR ROS.EXTRABOARD_BOX_RUNS;


GRANT DELETE, INSERT, SELECT ON ROS.EXTRABOARD_BOX_RUNS TO ROS_DS;
grant select on ROS.EXTRABOARD_BOX_RUNS to ROS_USER;

--------------------------------------------------------
SPOOL OFF;

COMMIT;