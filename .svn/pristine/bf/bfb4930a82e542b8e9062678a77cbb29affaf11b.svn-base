REM
REM RUN THIS SCRIPT AS ROS
REM

CREATE TABLE RUNS
(
  RUN_ID                   VARCHAR2(10 BYTE),
  DIVISION_ID              NUMBER(38),
  RUN_TYPE                 CHAR(1 BYTE),
  RUN_SEQUENCE             NUMBER(38),
  BLOCK_NBR                VARCHAR2(7 BYTE),
  SHIFT                    CHAR(1 BYTE),
  SVC_TYPE                 NUMBER(38),
  RUN_PIECES               NUMBER(38),
  BLOCK_SEQUENCE           NUMBER(38),
  FROM_RUN_ID              VARCHAR2(10 BYTE),
  TO_RUN_ID                VARCHAR2(10 BYTE),
  START_TRIP_ID            NUMBER(38),
  START_NODE_ID            NUMBER(38),
  START_STOP_ID            NUMBER(38),
  END_TRIP_ID              NUMBER(38),
  END_NODE_ID              NUMBER(38),
  END_STOP_ID              NUMBER(38),
  ON_TIME                  VARCHAR2(5 BYTE),
  OFF_TIME                 VARCHAR2(5 BYTE),
  CLEAR_MINUTES            NUMBER(38),
  SIGNUP_MINUTES           NUMBER(38),
  PAD_MINUTES              NUMBER(38),
  TRAVEL_MINUTES           NUMBER(38),
  WORK_MINUTES             NUMBER(38),
  SWING_MINUTES            NUMBER(38),
  OVERTIME_MINUTES         NUMBER(38),
  PLATFORM_MINUTES         NUMBER(38),
  INTERVEN_MINUTES         NUMBER(38),
  DEADHEAD_CUSHION         NUMBER(38),
  BAGGAGE                  VARCHAR2(1 BYTE),
  TRAVEL_TO_MINUTES        NUMBER(38),
  TRAVEL_FROM_MINUTES      NUMBER(38),
  DRIVE_TIME               NUMBER(38),
  SPECIAL_RIDE             VARCHAR2(2 BYTE),
  TRAPEZE_ID               NUMBER(38),
  TRAPEZE_RUNTYPE          VARCHAR2(10 BYTE),
  SPREAD_OVERTIME_MINUTES  NUMBER(38),
  REGULAR_MINUTES          NUMBER(38)
)
TABLESPACE ROS_DATA
PCTUSED    0
PCTFREE    10
INITRANS   1
MAXTRANS   255
STORAGE    (
            INITIAL          64K
            MINEXTENTS       1
            MAXEXTENTS       UNLIMITED
            PCTINCREASE      0
            BUFFER_POOL      DEFAULT
           )
LOGGING 
NOCOMPRESS 
NOCACHE
NOPARALLEL
MONITORING
/


