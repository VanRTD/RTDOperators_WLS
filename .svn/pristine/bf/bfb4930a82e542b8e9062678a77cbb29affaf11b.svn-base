GRANT SELECT, UPDATE, INSERT, DELETE ON ROS.AUTHORITIES TO ROS_USER.AUTHORITIES;
GRANT SELECT, UPDATE, INSERT, DELETE ON ROS.BLOCKS TO ROS_USER.BLOCKS;
