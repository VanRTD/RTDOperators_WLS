<?xml version="1.0" encoding="UTF-8"?>

<beans:beans xmlns="http://www.springframework.org/schema/security"
	xmlns:beans="http://www.springframework.org/schema/beans"
	xmlns:security="http://www.springframework.org/schema/security"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
              http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-2.0.4.xsd">

	<http auto-config='true' access-denied-page="/operator/403.jsp">

		<intercept-url pattern="/getRetrieveAccountForm.do" access="ROLE_ANONYMOUS" />
		<intercept-url pattern="/verifyUserSecurityAnswers.do" access="ROLE_ANONYMOUS" />
		<intercept-url pattern="/savePassword.do" access="ROLE_ANONYMOUS" />
		<!--<intercept-url pattern="/index.do" access="ROLE_ANONYMOUS,ROLE_LOGGEDIN,ROLE_OPERATOR,ROLE_ADMIN" /> -->
		<intercept-url pattern="/jsp/loginForm.jsp" access="ROLE_ANONYMOUS,ROLE_LOGGEDIN,ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_ADMIN" />
		<form-login login-page="/getLoginForm.do" authentication-failure-url="/getLoginForm.do" default-target-url="/secure/index.do" /> 
		<intercept-url pattern="/getLoginForm.do" access="ROLE_ANONYMOUS,ROLE_USER,ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_ADMIN" />
		<intercept-url pattern="/createAccount.do" access="ROLE_ANONYMOUS" />
		<intercept-url pattern="/createSecurityQuestions.do" access="ROLE_ANONYMOUS" />
		<intercept-url pattern="/getEmploymentTypeSelection.do" access="ROLE_ANONYMOUS" />
		<intercept-url pattern="/WEB-INF/jsp/**" access="ROLE_ANONYMOUS,ROLE_LOGGEDIN,ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_ADMIN" />
		<intercept-url pattern="/css/**" access="ROLE_ANONYMOUS,ROLE_LOGGEDIN,ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_ADMIN" />
		<intercept-url pattern="/images/**" access="ROLE_ANONYMOUS,ROLE_LOGGEDIN,ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_ADMIN" />
		<intercept-url pattern="/secure/**" access="ROLE_OPERATOR_EMP,ROLE_OPERATOR_CONT,ROLE_LOGGEDIN,ROLE_ADMIN" />
		<concurrent-session-control max-sessions="1" />
		<logout />
	</http>

	<authentication-provider>
		<password-encoder hash="sha" base64="true" />
		<jdbc-user-service data-source-ref="dataSource"
			users-by-username-query="select username,password,enabled from OPERATOR_USERS where username=?" />
	</authentication-provider>

</beans:beans>
