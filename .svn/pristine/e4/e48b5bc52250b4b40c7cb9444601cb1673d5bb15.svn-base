$DEFINE Pin%%V0S2P3.Column%%2 STAGECOM.ARR(6)
$DEFINE Pin%%V0S2P3.Column%%3 STAGECOM.ARR(8)
$DEFINE Pin%%V0S2P3.Column%%4 STAGECOM.ARR(7)
$DEFINE Pin%%V0S2P3.Column%%5 STAGECOM.ARR(5)
$DEFINE PUT.Pin%%V0S2P3 CALL $DS.SEQPUT(3, Pin%%V0S2P3.REJECTEDCODE)

UPDATE.COUNT = STAGECOM.RATE

* Stage Variable initialization
IF NOT(STAGECOM.STAGE<STAGE.VAR.INITED,1>) THEN
	STAGECOM.STAGE<STAGE.VAR.INITED,1> = @TRUE
	V0S2.Stagevar%%1 = 0
END
IF NOT(STAGECOM.STAGE<STAGE.VAR.INITED,2>) THEN
	STAGECOM.STAGE<STAGE.VAR.INITED,2> = @TRUE
	V0S2.Stagevar%%2 = 0
END


LOOP
	REJECTED = @TRUE
	* Get next row from primary input pin extract
	STAGECOM.PINNO = 1
	GET.Pin%%V0S2P5
	ERROR = Pin%%V0S2P5.REJECTEDCODE
WHILE NOT(ERROR)
	* Stage variable evaluation
IF STAGECOM.TRACE.STATS THEN CALL $PERF.BEGIN(-2)
	V0S2.Stagevar%%1 = Oconv(Iconv(Pin%%V0S2P5.Column%%3, "D/MDY"), "D-YMD") : '00:00:00'
	V0S2.Stagevar%%2 =  IF Len(Pin%%V0S2P5.Column%%6) <> 0 THEN  IF Len(Pin%%V0S2P5.Column%%8) = 0 AND Len(Pin%%V0S2P5.Column%%7) = 0 THEN Pin%%V0S2P5.Column%%6 ELSE  IF Len(Pin%%V0S2P5.Column%%8) = 0 AND Len(Pin%%V0S2P5.Column%%7) > 0 THEN Pin%%V0S2P5.Column%%6 : ' ' : Pin%%V0S2P5.Column%%7 ELSE  IF Len(Pin%%V0S2P5.Column%%8) > 0 AND Len(Pin%%V0S2P5.Column%%7) = 0 THEN Pin%%V0S2P5.Column%%6 : ' ' : Pin%%V0S2P5.Column%%8 ELSE  IF Pin%%V0S2P5.Column%%7 <> Pin%%V0S2P5.Column%%8 THEN Pin%%V0S2P5.Column%%6 : ' ' : Pin%%V0S2P5.Column%%7 : ' ' : Pin%%V0S2P5.Column%%8 ELSE Pin%%V0S2P5.Column%%6 : ' ' : Pin%%V0S2P5.Column%%7 ELSE  IF Len(Pin%%V0S2P5.Column%%8) = 0 AND Len(Pin%%V0S2P5.Column%%7) = 0 THEN '' ELSE  IF Len(Pin%%V0S2P5.Column%%8) = 0 AND Len(Pin%%V0S2P5.Column%%7) > 0 THEN Pin%%V0S2P5.Column%%7 ELSE  IF Len(Pin%%V0S2P5.Column%%8) > 0 AND Len(Pin%%V0S2P5.Column%%7) = 0 THEN Pin%%V0S2P5.Column%%8 ELSE  IF Pin%%V0S2P5.Column%%7 <> Pin%%V0S2P5.Column%%8 THEN Pin%%V0S2P5.Column%%7 : ' ' : Pin%%V0S2P5.Column%%8 ELSE Pin%%V0S2P5.Column%%7
IF STAGECOM.TRACE.STATS THEN CALL $PERF.END(-2)

	STAGECOM.PINNO = 2
	* This is the first link in this TXN group, start the transaction.
	IF BCICOM.TXGROUPSTATUS<1,1> = "" OR BCICOM.TXGROUPSTATUS<1,1> = 0 THEN
	    TXSTATUS = 0
	    CALL $DSP.TxnStart(2, TXSTATUS)
	    IF TXSTATUS = TXNStarted THEN BCICOM.TXGROUPSTATUS<1,1> = TXSTATUS
	    BCICOM.TXGROUPSTATUS<1,2> = 2	;* Pin handle
	END
	Pin%%V0S2P2.REJECTEDCODE = 0
	IF BCICOM.TXGROUPSTATUS<1,1> = TXNStarted THEN
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.BEGIN(-3)
	    IF @TRUE THEN
		* Column derivation code for pin laod
		Pin%%V0S2P2.REJECTED = @FALSE
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.END(-3)

		PUT.Pin%%V0S2P2
		IF NOT(Pin%%V0S2P2.REJECTEDCODE) THEN
		    REJECTED = @FALSE
		END ELSE 
		    Pin%%V0S2P2.REJECTED = @TRUE
	   	    * TXN Continue on SQL write failure
		END 
	    END
	    ELSE
		Pin%%V0S2P2.REJECTED = @TRUE
		Pin%%V0S2P2.REJECTEDCODE = 0
		* TXN Continue on link constraint failure
	    END
	END

	STAGECOM.PINNO = 3
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.BEGIN(-4)
	    IF REJECTED THEN
		* Column derivation code for pin reject
		Pin%%V0S2P3.Column%%1 = (Pin%%V0S2P5.Column%%1 : '*' : Pin%%V0S2P5.Column%%2 : '*' : Pin%%V0S2P5.Column%%4)
		Pin%%V0S2P3.REJECTED = @FALSE
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.END(-4)

		PUT.Pin%%V0S2P3
		IF NOT(Pin%%V0S2P3.REJECTEDCODE) THEN
		    REJECTED = @FALSE
		END ELSE 
		    Pin%%V0S2P3.REJECTED = @TRUE
		END 
	    END
	    ELSE
		Pin%%V0S2P3.REJECTED = @TRUE
		Pin%%V0S2P3.REJECTEDCODE = 0
	    END


	FOR I = 1 TO 1
	    IF BCICOM.TXGROUPSTATUS<I,1> <> "" THEN BCICOM.TXGROUPSTATUS<I,1> = TXNStarted
	NEXT I

  UPDATE.COUNT -= 1
  IF UPDATE.COUNT LE 0 THEN CALL DSD.Update(HANDLES);UPDATE.COUNT = STAGECOM.RATE
REPEAT
 
IF (ERROR = DSE.EOF) or (ERROR = DSE.EOT) THEN
    TXSTATUS = 0
    * Transaction size is 0 - commit pending rows.
    CALL $DSP.TxnCommit(2, TXSTATUS)
END
RETURN
END

