      BEGIN DSSUBRECORD
         Name "USERSQL"
         Value =+=+=+=
SELECT td.DIVISION_ABBREVIATION as DIVISION, 
   t.BOARD_TYPE,
   TO_CHAR(t.BOARD_DATE, 'MM/DD/YYYY'),
   t.EMPLOYEE_NUMBER,
   t.FULL_NAME_LFM,
   t.ASSIGNMENT_DESC,
   t.PREFIX_COMMENTS,
   t.SUFFIX_COMMENTS,
   t.RUN_NUMBER1,
   t.RUN_PIECE_NUMBER1,
   t.RUN_NUMBER2,
   t.RUN_PIECE_NUMBER2,
   t.RUN_NUMBER3,
   t.RUN_PIECE_NUMBER3,
   t.RUN_NUMBER4,
   t.RUN_PIECE_NUMBER4
FROM TIES.TIES_EXTRABOARD_FINAL_WEB t
join TIES.TIES_DIVISIONS td
on td.DIVISION_ID = t.DIVISION_ID
ORDER BY td.DIVISION_ABBREVIATION, t.BOARD_DATE,  t.FULL_NAME_LFM
=+=+=+=
      END DSSUBRECORD
