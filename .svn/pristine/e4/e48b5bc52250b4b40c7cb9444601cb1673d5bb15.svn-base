RUN2_PIECES VARCHAR(1), 
RUN3_ID VARCHAR(10), 
RUN3_PIECES VARCHAR(1), 
RUN4_ID VARCHAR(10), 
RUN4_PIECES VARCHAR(1)
, PRIMARY KEY (EXTRABOARD_ID) )

=+=+=+=
