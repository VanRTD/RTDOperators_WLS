CREATE TABLE	EXTRABOARD (
EXTRABOARD_ID VARCHAR(12) NOT NULL, 
DIVISION VARCHAR(2) NOT NULL, 
SHIFT VARCHAR(2) NOT NULL, 
VALID_DATE DATE NOT NULL, 
EMP_ID VARCHAR(7) NOT NULL, 
