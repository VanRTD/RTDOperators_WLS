      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "USERCREATEDDL"
         Value =+=+=+=
CREATE TABLE	EXTRABOARD_BOX_RUNS (
VALID_DATE DATE, 
RUN_NUMBER VARCHAR(38), 
RUN_PIECE_NUMBER DECIMAL(38), 
SERVICE_TYPE_ID DECIMAL(3), 
BLOCK_NUMBER DECIMAL(4), 
ROUTE_ABBR VARCHAR(10), 
BLOCK_PULLOUT VARCHAR(5), 
BLOCK_PULLIN VARCHAR(5), 
BOX_NBR DECIMAL(4), 
RELIEF_BOX_NUM VARCHAR(10), 
BOX_SUFFIX VARCHAR(10), 
FIRST_ROUTE VARCHAR(10), 
LAST_ROUTE VARCHAR(10), 
SIGNUP_TIME VARCHAR(5), 
ON_TIME VARCHAR(5), 
OFF_TIME VARCHAR(5), 
RELIEF_LOCATION VARCHAR(10)
 )

=+=+=+=
      END DSSUBRECORD
