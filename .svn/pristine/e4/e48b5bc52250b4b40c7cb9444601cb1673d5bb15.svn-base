      BEGIN DSSUBRECORD
         Name "temDateConvert"
         Expression "Oconv(Iconv(extract.BOARD_DATE, \"D/MDY\") , \"D-YMD\"):'00:00:00' "
         SqlType "3"
         ParsedExpression "Oconv(Iconv(extract.BOARD_DATE, \"D/MDY\"), \"D-YMD\") : '00:00:00'"
         SourceColumn "extract.BOARD_DATE"
         Precision "0"
         ColScale "0"
         ExtendedPrecision "0"
