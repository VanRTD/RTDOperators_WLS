      BEGIN DSSUBRECORD
         Name "temAssignment"
         Expression =+=+=+=
IF Len(extract.ASSIGNMENT_DESC) <> 0 THEN 
\(9)IF Len(extract.SUFFIX_COMMENTS) =  0 AND Len(extract.PREFIX_COMMENTS) =  0 THEN\(A)\(9)\(9)extract.ASSIGNMENT_DESC
\(9)ELSE IF Len(extract.SUFFIX_COMMENTS) =  0 AND Len(extract.PREFIX_COMMENTS) >   0 THEN 
\(9)\(9)extract.ASSIGNMENT_DESC:' ':extract.PREFIX_COMMENTS
\(9)ELSE IF Len(extract.SUFFIX_COMMENTS) > 0 AND Len(extract.PREFIX_COMMENTS) =   0 THEN 
\(9)\(9)extract.ASSIGNMENT_DESC:' ':extract.SUFFIX_COMMENTS
\(9)ELSE IF extract.PREFIX_COMMENTS <>  extract.SUFFIX_COMMENTS  THEN 
\(9)\(9)extract.ASSIGNMENT_DESC:' ': extract.PREFIX_COMMENTS:' ':extract.SUFFIX_COMMENTS 
\(9)ELSE  extract.ASSIGNMENT_DESC :' ': extract.PREFIX_COMMENTS
ELSE 
\(9)IF Len(extract.SUFFIX_COMMENTS) =  0 AND Len(extract.PREFIX_COMMENTS) =  0 THEN
\(9)\(9)''
\(9)ELSE IF Len(extract.SUFFIX_COMMENTS) =  0 AND Len(extract.PREFIX_COMMENTS) >   0 THEN 
\(9)\(9)extract.PREFIX_COMMENTS
\(9)ELSE IF Len(extract.SUFFIX_COMMENTS) > 0 AND Len(extract.PREFIX_COMMENTS) =   0 THEN 
\(9)\(9)extract.SUFFIX_COMMENTS
\(9)ELSE IF extract.PREFIX_COMMENTS <>  extract.SUFFIX_COMMENTS THEN 
\(9)\(9)extract.PREFIX_COMMENTS:' ':extract.SUFFIX_COMMENTS 
\(9)ELSE  extract.PREFIX_COMMENTS

=+=+=+=
         SqlType "3"
         ParsedExpression " IF Len(extract.ASSIGNMENT_DESC) <> 0 THEN  IF Len(extract.SUFFIX_COMMENTS) = 0 AND Len(extract.PREFIX_COMMENTS) = 0 THEN extract.ASSIGNMENT_DESC ELSE  IF Len(extract.SUFFIX_COMMENTS) = 0 AND Len(extract.PREFIX_COMMENTS) > 0 THEN extract.ASSIGNMENT_DESC : ' ' : extract.PREFIX_COMMENTS ELSE  IF Len(extract.SUFFIX_COMMENTS) > 0 AND Len(extract.PREFIX_COMMENTS) = 0 THEN extract.ASSIGNMENT_DESC : ' ' : extract.SUFFIX_COMMENTS ELSE  IF extract.PREFIX_COMMENTS <> extract.SUFFIX_COMMENTS THEN extract.ASSIGNMENT_DESC : ' ' : extract.PREFIX_COMMENTS : ' ' : extract.SUFFIX_COMMENTS ELSE extract.ASSIGNMENT_DESC : ' ' : extract.PREFIX_COMMENTS ELSE  IF Len(extract.SUFFIX_COMMENTS) = 0 AND Len(extract.PREFIX_COMMENTS) = 0 THEN '' ELSE  IF Len(extract.SUFFIX_COMMENTS) = 0 AND Len(extract.PREFIX_COMMENTS) > 0 THEN extract.PREFIX_COMMENTS ELSE  IF Len(extract.SUFFIX_COMMENTS) > 0 AND Len(extract.PREFIX_COMMENTS) = 0 THEN extract.SUFFIX_COMMENTS ELSE  IF extract.PREFIX_COMMENTS <> extract.SUFFIX_COMMENTS THEN extract.PREFIX_COMMENTS : ' ' : extract.SUFFIX_COMMENTS ELSE extract.PREFIX_COMMENTS"
         SourceColumn "extract.ASSIGNMENT_DESC;extract.SUFFIX_COMMENTS;extract.PREFIX_COMMENTS"
         Precision "0"
         ColScale "0"
         ExtendedPrecision "0"
      END DSSUBRECORD
