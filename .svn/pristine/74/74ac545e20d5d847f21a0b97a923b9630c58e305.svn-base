package com.rtd.operator.model.extraboard;

public class Blocks {

	private String blockNumber;
	private String routeAbbr;
	private String pullinTime;
	private String pulloutTime;
	private String signupTime;
	private String boxNbr;
	private String firstRoute;
	private String lastRoute;
	private String runPieceNumber;
	private String onTime;
	private String offTime;
	private String reliefLocation;
	private String runNumber;

	public Blocks() {
		super();
	}

	public static Blocks newInstance(final String blockNumber, final String routeAbbr,
			String pulloutTime, String pullinTime, String signupTime,
			String boxNbr, String firstRoute,
			String lastRoute, String runPieceNumber,
			String onTime, String offTime,
			String reliefLocation, String runNumber) {
		final Blocks block = new Blocks();
		block.setBlockNumber(blockNumber);
		block.setRouteAbbr(routeAbbr);
		block.setPullinTime(pullinTime);
		block.setPulloutTime(pulloutTime);
		block.setSignupTime(signupTime);
		block.setBoxNbr(boxNbr);
		block.setFirstRoute(firstRoute);
		block.setLastRoute(lastRoute);
		block.setRunPieceNumber(runPieceNumber);
		block.setOnTime(onTime);
		block.setOffTime(offTime);
		block.setReliefLocation(reliefLocation);
		block.setRunNumber(runNumber);
		return block;
	}

	/**
	 * @return the blockNumber
	 */
	public String getblockNumber() {
		return blockNumber;
	}

	/**
	 * @param blockNumber
	 *            the blockNumber to set
	 */
	public void setBlockNumber(String blockNumber) {
		this.blockNumber = blockNumber;
	}

	/**
	 * @return the routeAbbr
	 */
	public String getRouteAbbr() {
		return routeAbbr;
	}

	/**
	 * @param routeAbbr
	 *            the routeAbbr to set
	 */
	public void setRouteAbbr(String routeAbbr) {
		this.routeAbbr = routeAbbr;
	}

	/**
	 * @return the pullinTime
	 */
	public String getPullinTime() {
		return pullinTime;
	}

	/**
	 * @param pullinTime
	 *            the pullinTime to set
	 */
	public void setPullinTime(String pullinTime) {
		this.pullinTime = pullinTime;
	}

	/**
	 * @return the pulloutTime
	 */
	public String getPulloutTime() {
		return pulloutTime;
	}

	/**
	 * @param pulloutTime
	 *            the pulloutTime to set
	 */
	public void setPulloutTime(String pulloutTime) {
		this.pulloutTime = pulloutTime;
	}

	/**
	 * @return the signupTime
	 */
	public String getSignupTime() {
		return signupTime;
	}

	/**
	 * @param signupTime
	 *            the signupTime to set
	 */
	public void setSignupTime(String signupTime) {
		this.signupTime = signupTime;
	}

	/**
	 * @return the boxNbr
	 */
	public String getBoxNbr() {
		return boxNbr;
	}

	/**
	 * @param boxNbr
	 *            the boxNbr to set
	 */
	public void setBoxNbr(String boxNbr) {
		this.boxNbr = boxNbr;
	}

	/**
	 * @return the firstRoute
	 */
	public String getFirstRoute() {
		return firstRoute;
	}

	/**
	 * @param firstRoute
	 *            the firstRoute to set
	 */
	public void setFirstRoute(String firstRoute) {
		this.firstRoute = firstRoute;
	}

	/**
	 * @return the lastRoute
	 */
	public String getLastRoute() {
		return lastRoute;
	}

	/**
	 * @param lastRoute
	 *            the lastRoute to set
	 */
	public void setLastRoute(String lastRoute) {
		this.lastRoute = lastRoute;
	}

	public String getRunPieceNumber() {
		return runPieceNumber;
	}

	public void setRunPieceNumber(String runPieceNumber) {
		this.runPieceNumber = runPieceNumber;
	}

	public String getOnTime() {
		return onTime;
	}

	public void setOnTime(String onTime) {
		this.onTime = onTime;
	}

	public String getOffTime() {
		return offTime;
	}

	public void setOffTime(String offTime) {
		this.offTime = offTime;
	}

	public String getReliefLocation() {
		return reliefLocation;
	}

	public void setReliefLocation(String reliefLocation) {
		this.reliefLocation = reliefLocation;
	}

	public String getRunNumber() {
		return runNumber;
	}

	public void setRunNumber(String runNumber) {
		this.runNumber = runNumber;
	}
}
