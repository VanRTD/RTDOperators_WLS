CREATE TABLESPACE ROS_DATA DATAFILE
  '/ecore01t/db05/ros_data01.dbf' SIZE 500M AUTOEXTEND ON NEXT 8K MAXSIZE 2000M
LOGGING
ONLINE
PERMANENT
EXTENT MANAGEMENT LOCAL AUTOALLOCATE
BLOCKSIZE 8K
SEGMENT SPACE MANAGEMENT AUTO
FLASHBACK ON
/



CREATE TABLESPACE ROS_IDX DATAFILE
  '/ecore01t/db06/ros_idx01.dbf' SIZE 500M AUTOEXTEND ON NEXT 8K MAXSIZE 2000M
LOGGING
ONLINE
PERMANENT
EXTENT MANAGEMENT LOCAL AUTOALLOCATE
BLOCKSIZE 8K
SEGMENT SPACE MANAGEMENT AUTO
FLASHBACK ON
/
