package com.rtd.operator.model.extraboard;

import java.util.Date;

public class Extraboard {

	private String empId;
	private String division;
	private String validDate;
	private String empNum;
	private String empName;
	private String assignment;
	private String shift;
	private String run1Id;
	private String run1Pieces;
	private String run2Id;
	private String run2Pieces;
	private String run3Id;
	private String run3Pieces;
	private String run4Id;
	private String run4Pieces;
	private Date vdDate;

	// constructor
	public Extraboard() {
		super();
	}

	/* getters and setters */

	public String getEmpId() {
		return empId;
	}

	public void setEmpId(String empId) {
		this.empId = empId;
	}

	public String getValidDate() {
		return validDate;
	}

	public void setValidDate(String validDate) {
		this.validDate = validDate;
	}

	public String getEmpNum() {
		return empNum;
	}

	public void setEmpNum(String empNum) {
		this.empNum = empNum;
	}

	public String getEmpName() {
		return empName;
	}

	public void setEmpName(String empName) {
		this.empName = empName;
	}

	public String getAssignment() {
		return assignment;
	}

	public void setAssignment(String assignment) {
		this.assignment = assignment;
	}

	public String getShift() {
		return shift;
	}

	public void setShift(String shift) {
		this.shift = shift;
	}

	public String getDivision() {
		return division;
	}

	public void setDivision(String division) {
		this.division = division;
	}

	/**
	 * @return the run1Id
	 */
	public String getRun1Id() {
		return run1Id;
	}

	/**
	 * @param run1Id the run1Id to set
	 */
	public void setRun1Id(String run1Id) {
		this.run1Id = run1Id;
	}

	/**
	 * @return the run1Pieces
	 */
	public String getRun1Pieces() {
		return run1Pieces;
	}

	/**
	 * @param run1Pieces the run1Pieces to set
	 */
	public void setRun1Pieces(String run1Pieces) {
		this.run1Pieces = run1Pieces;
	}

	/**
	 * @return the run2Id
	 */
	public String getRun2Id() {
		return run2Id;
	}

	/**
	 * @param run2Id the run2Id to set
	 */
	public void setRun2Id(String run2Id) {
		this.run2Id = run2Id;
	}

	/**
	 * @return the run2Pieces
	 */
	public String getRun2Pieces() {
		return run2Pieces;
	}

	/**
	 * @param run2Pieces the run2Pieces to set
	 */
	public void setRun2Pieces(String run2Pieces) {
		this.run2Pieces = run2Pieces;
	}

	/**
	 * @return the run3Id
	 */
	public String getRun3Id() {
		return run3Id;
	}

	/**
	 * @param run3Id the run3Id to set
	 */
	public void setRun3Id(String run3Id) {
		this.run3Id = run3Id;
	}

	/**
	 * @return the run3Pieces
	 */
	public String getRun3Pieces() {
		return run3Pieces;
	}

	/**
	 * @param run3Pieces the run3Pieces to set
	 */
	public void setRun3Pieces(String run3Pieces) {
		this.run3Pieces = run3Pieces;
	}

	/**
	 * @return the run4Id
	 */
	public String getRun4Id() {
		return run4Id;
	}

	/**
	 * @param run4Id the run4Id to set
	 */
	public void setRun4Id(String run4Id) {
		this.run4Id = run4Id;
	}

	/**
	 * @return the run4Pieces
	 */
	public String getRun4Pieces() {
		return run4Pieces;
	}

	/**
	 * @param run4Pieces the run4Pieces to set
	 */
	public void setRun4Pieces(String run4Pieces) {
		this.run4Pieces = run4Pieces;
	}

	public Date getVdDate() {
		return vdDate;
	}

	public void setVdDate(Date vdDate) {
		this.vdDate = vdDate;
	}
	
}
