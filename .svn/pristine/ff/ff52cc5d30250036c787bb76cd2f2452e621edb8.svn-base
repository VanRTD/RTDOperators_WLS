package com.rtd.operator.model;

public class OperatorRestroomInfo {
	private String fileName;
	private String fileNameWithoutExtension;
	private String fileDateModified;
	
	public OperatorRestroomInfo()
	{
		super();
	}

	public String getFileName() {
		return fileName;
	}

	public void setFileName(String fileName) {
		this.fileName = fileName;
	}

	public String getFileNameWithoutExtension() {
		return fileNameWithoutExtension;
	}

	public void setFileNameWithoutExtension(String fileNameWithoutExtension) {
		this.fileNameWithoutExtension = fileNameWithoutExtension;
	}

	public String getFileDateModified() {
		return fileDateModified;
	}

	public void setFileDateModified(String fileDateModified) {
		this.fileDateModified = fileDateModified;
	}
}
